{
  "name": "gih",
  "version": "1.0.0",
  "description": "Visual Git workstation and interactive graph shell",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "tsc && vite build && electron-builder",
    "package:win": "tsc && vite build && electron-builder --win",
    "package:win:x64": "tsc && vite build && electron-builder --win --x64",
    "package:win:arm64": "tsc && vite build && electron-builder --win --arm64",
    "package:installer": "tsc && vite build && electron-builder --win nsis",
    "package:portable": "tsc && vite build && electron-builder --win portable",
    "package:mac": "tsc && vite build && electron-builder --mac",
    "package:linux": "tsc && vite build && electron-builder --linux",
    "package:all": "tsc && vite build && electron-builder -mwl",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anames-dex/Gih.git"
  },
  "keywords": [
    "git",
    "git-gui",
    "developer-tools",
    "graph",
    "visual-git",
    "source-available"
  ],
  "author": "Anames-dex <natelligence.ai@gmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/Anames-dex/Gih/issues"
  },
  "homepage": "https://github.com/Anames-dex/Gih#readme",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.anamesdex.gih",
    "productName": "Gih",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Gih",
      "artifactName": "Gih-Setup-${version}-${arch}.${ext}",
      "uninstallDisplayName": "Gih"
    },
    "portable": {
      "artifactName": "Gih-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "public/logo.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Gih-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/logo.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Gih-${version}-${arch}.${ext}"
    }
  }
}
